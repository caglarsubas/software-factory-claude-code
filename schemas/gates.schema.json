{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/caglarsubas/software-factory-claude-code/main/schemas/gates.schema.json",
  "title": "Gate results",
  "description": "Deterministic gate outcomes and the risk signals they emit.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "defs.schema.json#/$defs/schemaVersion"
    },
    "task_id": {
      "$ref": "defs.schema.json#/$defs/taskId"
    },
    "candidate_commit": {
      "$ref": "defs.schema.json#/$defs/gitSha"
    },
    "passed": {
      "type": "boolean"
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "skipped",
              "error"
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "$ref": "defs.schema.json#/$defs/text"
          }
        },
        "required": [
          "name",
          "status",
          "duration_ms",
          "summary"
        ]
      },
      "minItems": 1
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sink_added": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/sink"
          }
        },
        "secret_material": {
          "type": "boolean"
        }
      },
      "required": [
        "sink_added",
        "secret_material"
      ]
    },
    "graph": {
      "description": "The candidate's code graph (P2-13), advisory: built, or why not. graph.json itself is a separate artifact.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "built",
            "error"
          ]
        },
        "tool": {
          "type": "string",
          "pattern": "^graphifyy [0-9][^ ]*$"
        },
        "commit": {
          "$ref": "defs.schema.json#/$defs/gitSha"
        },
        "nodes": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "tool",
        "commit"
      ],
      "if": {
        "properties": {
          "status": {
            "const": "built"
          }
        }
      },
      "then": {
        "required": [
          "nodes",
          "edges",
          "files",
          "sha256"
        ],
        "properties": {
          "nodes": true,
          "edges": true,
          "files": true,
          "sha256": true
        }
      },
      "else": {
        "required": [
          "detail"
        ],
        "properties": {
          "detail": true
        }
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "candidate_commit",
    "passed",
    "gates",
    "signals"
  ]
}
