{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/caglarsubas/software-factory-claude-code/main/schemas/event.schema.json",
  "title": "Event",
  "description": "One append-only event. Only factoryctl writes state_changed events.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "defs.schema.json#/$defs/schemaVersion"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "$ref": "defs.schema.json#/$defs/taskId"
    },
    "ts": {
      "$ref": "defs.schema.json#/$defs/timestamp"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "factoryctl",
            "operator",
            "agent",
            "github"
          ]
        },
        "id": {
          "$ref": "defs.schema.json#/$defs/text"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "type": {
      "enum": [
        "task_created",
        "state_changed",
        "stage_started",
        "stage_completed",
        "stage_failed",
        "command",
        "side_effect_intent",
        "side_effect_done",
        "artifact_committed",
        "alarm",
        "usage"
      ]
    },
    "from": {
      "$ref": "defs.schema.json#/$defs/state"
    },
    "to": {
      "$ref": "defs.schema.json#/$defs/state"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "seq",
    "task_id",
    "ts",
    "epoch",
    "actor",
    "type",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "state_changed"
          }
        }
      },
      "then": {
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "$ref": "defs.schema.json#/$defs/state"
          },
          "to": {
            "$ref": "defs.schema.json#/$defs/state"
          },
          "actor": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "factoryctl"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "artifact_committed"
          }
        }
      },
      "then": {
        "properties": {
          "actor": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "factoryctl"
              }
            }
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "description": "The commit point of a stage's artifacts (P1-02): written after the files are staged as .pending and before they are moved into place.",
            "properties": {
              "stage": {
                "$ref": "defs.schema.json#/$defs/text"
              },
              "label": {
                "$ref": "defs.schema.json#/$defs/text"
              },
              "round": {
                "type": "integer",
                "minimum": 1
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "input_digest": {
                "$ref": "defs.schema.json#/$defs/digest"
              },
              "inputs": {
                "type": "object",
                "description": "The digest of each file the step read; an optional input that does not exist is recorded as \"missing\", so its later appearance re-runs the step.",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "$ref": "defs.schema.json#/$defs/digest"
                    },
                    {
                      "const": "missing"
                    }
                  ]
                }
              },
              "artifacts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
                    },
                    "digest": {
                      "$ref": "defs.schema.json#/$defs/digest"
                    }
                  },
                  "required": [
                    "path",
                    "digest"
                  ]
                }
              }
            },
            "required": [
              "stage",
              "label",
              "round",
              "attempt",
              "input_digest",
              "inputs",
              "artifacts"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "side_effect_intent"
          }
        }
      },
      "then": {
        "properties": {
          "actor": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "factoryctl"
              }
            }
          },
          "payload": {
            "type": "object",
            "description": "An outbox intent (P1-02): recorded before the effect is looked up or made. Events from before the outbox carry no key.",
            "properties": {
              "key": {
                "type": "string",
                "description": "task/stage/round/kind[/name] (D6).",
                "pattern": "^T-[0-9]{4,}/[a-z][a-z0-9-]*/[1-9][0-9]*/(push|pull_request|comment|check_run|merge)(/[A-Za-z0-9._-]+)?$"
              },
              "kind": {
                "enum": [
                  "push",
                  "pull_request",
                  "comment",
                  "check_run",
                  "merge"
                ]
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "key",
              "kind",
              "attempt"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "side_effect_done"
          }
        }
      },
      "then": {
        "properties": {
          "actor": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "factoryctl"
              }
            }
          },
          "payload": {
            "type": "object",
            "description": "The outcome of an outbox intent with the same key and attempt: made (done), already there (found), never made (absent, from reconcile) or failed.",
            "properties": {
              "key": {
                "type": "string",
                "description": "task/stage/round/kind[/name] (D6).",
                "pattern": "^T-[0-9]{4,}/[a-z][a-z0-9-]*/[1-9][0-9]*/(push|pull_request|comment|check_run|merge)(/[A-Za-z0-9._-]+)?$"
              },
              "kind": {
                "enum": [
                  "push",
                  "pull_request",
                  "comment",
                  "check_run",
                  "merge"
                ]
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "outcome": {
                "enum": [
                  "done",
                  "found",
                  "absent",
                  "failed"
                ]
              }
            },
            "required": [
              "key",
              "kind",
              "attempt",
              "outcome"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "alarm"
          }
        }
      },
      "then": {
        "properties": {
          "actor": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "factoryctl"
              }
            }
          },
          "payload": {
            "type": "object",
            "description": "The model alias alarm (P1-06): a session ran on a model ID config/factory.yaml does not pin, or an alias resolved to an ID no earlier live session of it ran on.",
            "properties": {
              "kind": {
                "enum": [
                  "unpinned_model",
                  "alias_new_id"
                ]
              },
              "label": {
                "$ref": "defs.schema.json#/$defs/text"
              },
              "alias": {
                "$ref": "defs.schema.json#/$defs/text"
              },
              "pinned": {
                "type": "string"
              },
              "resolved": {
                "$ref": "defs.schema.json#/$defs/text"
              },
              "seen": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "kind",
              "label",
              "alias",
              "pinned",
              "resolved"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "usage"
          }
        }
      },
      "then": {
        "properties": {
          "actor": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "factoryctl"
              }
            }
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "description": "One metered Messages API response (P2-02): what the credential gateway saw a session use, priced by the release's price table. The task's spend is the sum of these for its gateway sessions.",
            "properties": {
              "session": {
                "type": "string",
                "pattern": "^gw_[A-Za-z0-9_-]+$"
              },
              "label": {
                "$ref": "defs.schema.json#/$defs/text"
              },
              "model": {
                "type": "string",
                "pattern": "^claude-[a-z]+-[0-9]+(-[0-9]+)?$"
              },
              "usage": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "input_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "output_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cache_read_input_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cache_creation_input_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cache_creation_5m_input_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cache_creation_1h_input_tokens": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "input_tokens",
                  "output_tokens",
                  "cache_read_input_tokens",
                  "cache_creation_input_tokens",
                  "cache_creation_5m_input_tokens",
                  "cache_creation_1h_input_tokens"
                ]
              },
              "usd": {
                "type": "number",
                "minimum": 0
              },
              "reported": {
                "type": "boolean"
              },
              "request_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "session",
              "label",
              "model",
              "usage",
              "usd",
              "reported",
              "request_id"
            ]
          }
        }
      }
    }
  ]
}
