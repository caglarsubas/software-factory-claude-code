{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/caglarsubas/software-factory-claude-code/main/schemas/event.schema.json",
  "title": "Event",
  "description": "One append-only event. Only factoryctl writes state_changed events.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "defs.schema.json#/$defs/schemaVersion"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "task_id": {
      "$ref": "defs.schema.json#/$defs/taskId"
    },
    "ts": {
      "$ref": "defs.schema.json#/$defs/timestamp"
    },
    "epoch": {
      "type": "integer",
      "minimum": 0
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "factoryctl",
            "operator",
            "agent",
            "github"
          ]
        },
        "id": {
          "$ref": "defs.schema.json#/$defs/text"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "type": {
      "enum": [
        "task_created",
        "state_changed",
        "stage_started",
        "stage_completed",
        "stage_failed",
        "command",
        "side_effect_intent",
        "side_effect_done",
        "artifact_committed"
      ]
    },
    "from": {
      "$ref": "defs.schema.json#/$defs/state"
    },
    "to": {
      "$ref": "defs.schema.json#/$defs/state"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "seq",
    "task_id",
    "ts",
    "epoch",
    "actor",
    "type",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "state_changed"
          }
        }
      },
      "then": {
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "$ref": "defs.schema.json#/$defs/state"
          },
          "to": {
            "$ref": "defs.schema.json#/$defs/state"
          },
          "actor": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "factoryctl"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "artifact_committed"
          }
        }
      },
      "then": {
        "properties": {
          "actor": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "factoryctl"
              }
            }
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "description": "The commit point of a stage's artifacts (P1-02): written after the files are staged as .pending and before they are moved into place.",
            "properties": {
              "stage": {
                "$ref": "defs.schema.json#/$defs/text"
              },
              "label": {
                "$ref": "defs.schema.json#/$defs/text"
              },
              "round": {
                "type": "integer",
                "minimum": 1
              },
              "attempt": {
                "type": "integer",
                "minimum": 1
              },
              "input_digest": {
                "$ref": "defs.schema.json#/$defs/digest"
              },
              "inputs": {
                "type": "object",
                "description": "The digest of each file the step read; an optional input that does not exist is recorded as \"missing\", so its later appearance re-runs the step.",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "$ref": "defs.schema.json#/$defs/digest"
                    },
                    {
                      "const": "missing"
                    }
                  ]
                }
              },
              "artifacts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
                    },
                    "digest": {
                      "$ref": "defs.schema.json#/$defs/digest"
                    }
                  },
                  "required": [
                    "path",
                    "digest"
                  ]
                }
              }
            },
            "required": [
              "stage",
              "label",
              "round",
              "attempt",
              "input_digest",
              "inputs",
              "artifacts"
            ]
          }
        }
      }
    }
  ]
}
