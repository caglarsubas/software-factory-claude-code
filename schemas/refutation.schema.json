{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/caglarsubas/software-factory-claude-code/main/schemas/refutation.schema.json",
  "title": "Refutations",
  "description": "The refuter's answer to every blocking finding of one round (P1-03). Only a finding the refuter refuted stops blocking; upheld and unclear findings still block.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "$ref": "defs.schema.json#/$defs/schemaVersion"
    },
    "task_id": {
      "$ref": "defs.schema.json#/$defs/taskId"
    },
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "candidate_commit": {
      "$ref": "defs.schema.json#/$defs/gitSha"
    },
    "refutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^review-(code|security)/F-[0-9]+$",
            "description": "The reviewer's artifact label and the finding's id: ids are unique only per reviewer."
          },
          "decision": {
            "enum": [
              "refuted",
              "upheld",
              "unclear"
            ]
          },
          "evidence": {
            "$ref": "defs.schema.json#/$defs/text"
          },
          "model": {
            "$ref": "defs.schema.json#/$defs/text"
          }
        },
        "required": [
          "finding_id",
          "decision",
          "evidence",
          "model"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "round",
    "candidate_commit",
    "refutations"
  ]
}
