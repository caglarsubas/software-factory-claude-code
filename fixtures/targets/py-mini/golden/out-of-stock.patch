@@ -0,0 +1,9 @@
+from inventory.report import out_of_stock
+from inventory.stock import Stock
+
+
+def test_out_of_stock() -> None:
+    stock = Stock()
+    stock.add("pear", 0)
+    stock.add("apple", 2)
+    assert out_of_stock(stock) == ["pear"]
