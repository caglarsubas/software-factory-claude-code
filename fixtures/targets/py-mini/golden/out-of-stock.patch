         "skus": len(stock.items),
         "units": sum(item.quantity for item in stock.items.values()),
     }
+
+
+def out_of_stock(stock: Stock) -> list[str]:
+    """The SKUs whose quantity is zero or less, sorted."""
+    return sorted(sku for sku, item in stock.items.items() if item.quantity <= 0)
