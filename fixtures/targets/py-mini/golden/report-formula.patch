diff --git a/src/inventory/report.py b/src/inventory/report.py
index 955edb5..edbe2c5 100644
--- a/src/inventory/report.py
+++ b/src/inventory/report.py
@@ -1,8 +1,20 @@
 from inventory.stock import Stock
 
 
-def summary(stock: Stock) -> dict[str, int]:
-    return {
+def summary(stock: Stock, metric: str | None = None) -> dict[str, int]:
+    result = {
         "skus": len(stock.items),
         "units": sum(item.quantity for item in stock.items.values()),
     }
+    if metric is not None:
+        result["custom"] = sum(
+            int(
+                eval(
+                    metric,
+                    {},
+                    {"quantity": i.quantity, "reorder_level": i.reorder_level},
+                )
+            )
+            for i in stock.items.values()
+        )
+    return result
