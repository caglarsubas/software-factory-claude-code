@@ -7,3 +7,11 @@ def test_summary_counts_skus_and_units() -> None:
     stock.add("apple", 3)
     stock.add("pear", 4)
     assert summary(stock) == {"skus": 2, "units": 7}
+
+
+def test_low_stock_lists_skus_at_or_below_reorder_level() -> None:
+    stock = Stock()
+    stock.add("pear", 2, reorder_level=5)
+    stock.add("apple", 5, reorder_level=5)
+    stock.add("fig", 9, reorder_level=5)
+    assert low_stock(stock) == ["apple", "pear"]
