diff --git a/src/inventory/report.py b/src/inventory/report.py
index 955edb5..14be0fe 100644
--- a/src/inventory/report.py
+++ b/src/inventory/report.py
@@ -6,3 +6,10 @@ def summary(stock: Stock) -> dict[str, int]:
         "skus": len(stock.items),
         "units": sum(item.quantity for item in stock.items.values()),
     }
+
+
+def low_stock(stock: Stock) -> list[str]:
+    """SKUs at or below their reorder level, sorted."""
+    return sorted(
+        sku for sku, item in stock.items.items() if item.quantity <= item.reorder_level
+    )
