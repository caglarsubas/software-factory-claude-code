     assert verify_token("garbage", key) is None
+
+
+def test_a_token_expires_after_an_hour() -> None:
+    key = secrets.token_bytes(32)
+    token = issue_token("ada", key, 1_760_000_000)
+    assert verify_token(token, key, now=1_760_000_000 + 3599) == "ada"
+    assert verify_token(token, key, now=1_760_000_000 + 3601) is None
