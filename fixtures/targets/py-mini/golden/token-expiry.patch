diff --git a/src/inventory/auth/tokens.py b/src/inventory/auth/tokens.py
index cf8e192..58ea874 100644
--- a/src/inventory/auth/tokens.py
+++ b/src/inventory/auth/tokens.py
@@ -1,5 +1,8 @@
 import hashlib
 import hmac
+import time
+
+TOKEN_TTL_SECONDS = 60 * 60
 
 
 def _sign(payload: str, key: bytes) -> str:
@@ -11,12 +14,15 @@ def issue_token(user: str, key: bytes, issued_at: int) -> str:
     return f"{payload}.{_sign(payload, key)}"
 
 
-def verify_token(token: str, key: bytes) -> str | None:
-    """The token's user when its signature is valid, else None."""
+def verify_token(token: str, key: bytes, now: float | None = None) -> str | None:
+    """The token's user while its signature is valid and it is fresh, else None."""
     parts = token.rsplit(".", 2)
     if len(parts) != 3:
         return None
     user, issued_at, signature = parts
     if not hmac.compare_digest(_sign(f"{user}.{issued_at}", key), signature):
         return None
+    current = time.time() if now is None else now
+    if not issued_at.isdigit() or current - int(issued_at) > TOKEN_TTL_SECONDS:
+        return None
     return user
