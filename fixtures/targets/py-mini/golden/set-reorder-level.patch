+++ b/tests/test_reorder_level.py
@@ -0,0 +1,13 @@
+import pytest
+
+from inventory.stock import Stock
+
+
+def test_set_reorder_level() -> None:
+    stock = Stock()
+    stock.add("apple", 1)
+    assert stock.set_reorder_level("apple", 5).reorder_level == 5
+    with pytest.raises(ValueError):
+        stock.set_reorder_level("apple", -1)
+    with pytest.raises(ValueError):
+        stock.set_reorder_level("pear", 1)
