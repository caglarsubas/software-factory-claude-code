         return item
+
+    def set_reorder_level(self, sku: str, level: int) -> Item:
+        if level < 0:
+            raise ValueError("reorder level must not be negative")
+        item = self.items.get(sku)
+        if item is None:
+            raise ValueError(f"unknown sku: {sku}")
+        item.reorder_level = level
+        return item
