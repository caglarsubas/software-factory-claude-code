diff --git a/src/orders/export.ts b/src/orders/export.ts
new file mode 100644
index 0000000..d9731d4
--- /dev/null
+++ b/src/orders/export.ts
@@ -0,0 +1,7 @@
+import { stringify } from "yaml";
+import type { OrderStore } from "./store.ts";
+
+/** Every order as a YAML document, oldest first, amounts in cents. */
+export function exportOrdersYaml(store: OrderStore): string {
+  return stringify({ orders: store.all().map((o) => ({ id: o.id, customer: o.customer, total_cents: o.totalCents, created_at: o.createdAt })) });
+}
