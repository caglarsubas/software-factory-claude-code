diff --git a/src/orders/store.ts b/src/orders/store.ts
index 05f1bb0..a2fc967 100644
--- a/src/orders/store.ts
+++ b/src/orders/store.ts
@@ -12,6 +12,14 @@ export class OrderStore {
     this.#orders.push(order);
   }
 
+  /** Deletes the order with this id; false when there is none. */
+  remove(id: string): boolean {
+    const at = this.#orders.findIndex((o) => o.id === id);
+    if (at === -1) return false;
+    this.#orders.splice(at, 1);
+    return true;
+  }
+
   /** Every order, oldest first; ties broken by id. */
   all(): Order[] {
     return [...this.#orders].sort((a, b) => a.createdAt.localeCompare(b.createdAt) || a.id.localeCompare(b.id));
