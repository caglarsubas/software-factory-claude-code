@@ -0,0 +1,13 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { ordersFor } from "../src/orders/customer.ts";
+import { OrderStore } from "../src/orders/store.ts";
+
+test("lists one customer's orders oldest first", () => {
+  const s = new OrderStore();
+  s.add({ id: "b", customer: "ann", totalCents: 1, createdAt: "2026-01-02" });
+  s.add({ id: "x", customer: "bob", totalCents: 1, createdAt: "2026-01-01" });
+  s.add({ id: "a", customer: "ann", totalCents: 1, createdAt: "2026-01-01" });
+  assert.deepEqual(ordersFor(s, "ann").map((o) => o.id), ["a", "b"]);
+  assert.deepEqual(ordersFor(s, "eve"), []);
+});
