+++ b/src/orders/customer.ts
@@ -0,0 +1,6 @@
+import type { Order, OrderStore } from "./store.ts";
+
+/** One customer's orders, oldest first (ties broken by id, as OrderStore.all orders them). */
+export function ordersFor(store: OrderStore, customer: string): Order[] {
+  return store.all().filter((o) => o.customer === customer);
+}
