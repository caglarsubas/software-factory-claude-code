+import type { OrderStore } from "./store.ts";
+
+/** The sum of every order's total, in cents; 0 for an empty store. */
+export function ordersTotal(store: OrderStore): number {
+  return store.all().reduce((sum, o) => sum + o.totalCents, 0);
+}
