+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { OrderStore } from "../src/orders/store.ts";
+import { ordersTotal } from "../src/orders/totals.ts";
+
+test("sums every order's total", () => {
+  const s = new OrderStore();
+  assert.equal(ordersTotal(s), 0);
+  s.add({ id: "a", customer: "c", totalCents: 250, createdAt: "2026-01-01" });
+  s.add({ id: "b", customer: "d", totalCents: 1000, createdAt: "2026-01-02" });
+  assert.equal(ordersTotal(s), 1250);
+});
