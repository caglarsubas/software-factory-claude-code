diff --git a/src/auth/session.ts b/src/auth/session.ts
index a041fd5..ac51f22 100644
--- a/src/auth/session.ts
+++ b/src/auth/session.ts
@@ -14,11 +14,15 @@ export function signSession(session: Session, key: Buffer): string {
   return `${payload}.${sign(payload, key)}`;
 }
 
-export function verifySession(token: string, key: Buffer): Session | null {
+/** How long a session verifies after it was issued. */
+export const SESSION_TTL_SECONDS = 24 * 60 * 60;
+
+export function verifySession(token: string, key: Buffer, now: number = Date.now()): Session | null {
   const [payload, signature] = token.split(".");
   if (payload === undefined || signature === undefined) return null;
   const expected = Buffer.from(sign(payload, key));
   const actual = Buffer.from(signature);
   if (expected.length !== actual.length || !timingSafeEqual(expected, actual)) return null;
-  return JSON.parse(Buffer.from(payload, "base64url").toString("utf8")) as Session;
+  const session = JSON.parse(Buffer.from(payload, "base64url").toString("utf8")) as Session;
+  return now / 1000 - session.issuedAt > SESSION_TTL_SECONDS ? null : session;
 }
