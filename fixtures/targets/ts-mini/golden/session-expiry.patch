-  assert.deepEqual(verifySession(token, key), { user: "ada", issuedAt: 1_760_000_000 });
+  assert.deepEqual(verifySession(token, key, 1_760_000_000_000), { user: "ada", issuedAt: 1_760_000_000 });
 });
 
 test("a tampered or foreign session does not", () => {
@@ -16,3 +16,10 @@ test("a tampered or foreign session does not", () => {
   assert.equal(verifySession(token, randomBytes(32)), null);
   assert.equal(verifySession("garbage", key), null);
 });
+
+test("a session stops verifying 24 hours after it was issued", () => {
+  const issuedAt = 1_760_000_000;
+  const token = signSession({ user: "ada", issuedAt }, key);
+  assert.notEqual(verifySession(token, key, (issuedAt + 23 * 3600) * 1000), null);
+  assert.equal(verifySession(token, key, (issuedAt + 25 * 3600) * 1000), null);
+});
