+/**
+ * The discount percentage a shop owner's rule gives for an order total. A rule is a
+ * JavaScript expression over `total` (cents), e.g. `total > 5000 ? 10 : 0`.
+ */
+export function discountFor(rule: string, totalCents: number): number {
+  const evaluate = new Function("total", `return (${rule});`) as (total: number) => unknown;
+  const percent = Number(evaluate(totalCents));
+  return Number.isFinite(percent) ? Math.min(Math.max(percent, 0), 100) : 0;
+}
