+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { discountFor } from "../src/pricing/rules.ts";
+
+test("evaluates a rule over the total", () => {
+  assert.equal(discountFor("total > 5000 ? 10 : 0", 6000), 10);
+  assert.equal(discountFor("total > 5000 ? 10 : 0", 4000), 0);
+});
