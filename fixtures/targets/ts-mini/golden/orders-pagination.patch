+++ b/src/orders/page.ts
@@ -0,0 +1,23 @@
+import { DEFAULT_LIMIT, MAX_LIMIT } from "./list.ts";
+import type { Order, OrderStore } from "./store.ts";
+
+export interface PageOptions {
+  limit?: number;
+  /** The cursor from the previous page; omit it for the first page. */
+  after?: string;
+}
+
+export interface Page {
+  orders: Order[];
+  /** Pass as `after` to get the next page; null when there are no more orders. */
+  nextCursor: string | null;
+}
+
+export function listOrdersPage(store: OrderStore, options: PageOptions = {}): Page {
+  const limit = Math.min(Math.max(options.limit ?? DEFAULT_LIMIT, 1), MAX_LIMIT);
+  const all = store.all();
+  const start = options.after === undefined ? 0 : all.findIndex((o) => o.id === options.after) + 1;
+  const orders = all.slice(start, start + limit);
+  const last = orders.at(-1);
+  return { orders, nextCursor: last !== undefined && start + limit < all.length ? last.id : null };
+}
diff --git a/test/page.test.ts b/test/page.test.ts
new file mode 100644
