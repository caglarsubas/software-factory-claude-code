--- /dev/null
+++ b/test/page.test.ts
@@ -0,0 +1,14 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { listOrdersPage } from "../src/orders/page.ts";
+import { OrderStore } from "../src/orders/store.ts";
+
+test("pages through orders with a cursor", () => {
+  const s = new OrderStore();
+  for (let i = 1; i <= 3; i++) s.add({ id: `o${String(i)}`, customer: "c", totalCents: 1, createdAt: `2026-01-0${String(i)}` });
+  const first = listOrdersPage(s, { limit: 2 });
+  assert.deepEqual(first.orders.map((o) => o.id), ["o1", "o2"]);
+  const second = listOrdersPage(s, { limit: 2, after: first.nextCursor ?? "" });
+  assert.deepEqual(second.orders.map((o) => o.id), ["o3"]);
+  assert.equal(second.nextCursor, null);
+});
