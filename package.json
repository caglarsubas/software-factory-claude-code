{
  "name": "software-factory",
  "version": "0.0.0",
  "private": true,
  "description": "Target-agnostic software factory on Claude Code",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:md": "markdownlint-cli2",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:gates": "vitest run --config vitest.gates.config.ts",
    "test:runner": "vitest run --config vitest.runner.config.ts",
    "check:docs": "node scripts/check-docs.ts",
    "check:evals": "node scripts/check-evals.ts",
    "check:release": "node scripts/check-release.ts",
    "factoryctl": "node --disable-warning=ExperimentalWarning controller/src/cli/factoryctl.ts",
    "check": "pnpm lint && pnpm lint:md && pnpm typecheck && pnpm test && pnpm check:docs && pnpm check:evals && pnpm check:release"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "markdownlint-cli2": "0.23.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
