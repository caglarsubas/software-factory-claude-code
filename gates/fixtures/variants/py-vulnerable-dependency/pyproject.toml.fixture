[project]
name = "gates-fixture-py"
version = "0.0.0"
requires-python = ">=3.14"
dependencies = ["urllib3==2.2.1"]

[dependency-groups]
dev = ["mypy==2.4.0", "pytest==9.1.1", "ruff==0.16.10"]

[tool.uv]
package = false

[tool.mypy]
strict = true
files = ["src", "tests"]
mypy_path = "src"

[tool.ruff.lint]
select = ["E", "F", "I", "B"]

[tool.pytest.ini_options]
pythonpath = ["src"]
testpaths = ["tests"]
addopts = "-p no:cacheprovider"
